  "typography": {
    "body": {
      "font": "system-sans",
      "size": 16,
      "lineHeight": 1.55
    },
    "heading": {
      "font": "system-sans",
      "size": 30,
      "lineHeight": 1.2
    },
    "ui": {
      "font": "system-mono",
      "size": 14,
      "lineHeight": 1.35
    },
    "code": {
      "font": "system-mono",
      "size": 14,
      "lineHeight": 1.5
    }
  },
  "surfaces": {
    "borderStyle": "solid",
    "focusOffset": 3,
    "spacing": 4,
    "radii": 8,
    "border": 2,
    "focus": 3,
    "content": 704,
    "sidebar": 272
  },
  "layoutPreset": "standard",
  "components": {
    "pageTitle": "page-title-frame"
  },
  "codePresentation": {
    "mode": "expressive-code",
    "syntaxTheme": {
      "light": {
        "rules": [
          {
            "scopes": [
              "keyword"
            ],
            "foreground": "#8d3267"
          },
          {
            "scopes": [
              "string"
            ],
            "foreground": "#126475"
          },
          {
            "scopes": [
              "comment"
            ],
            "foreground": "#625a55"
          },
          {
            "scopes": [
              "entity.name.function"
            ],
            "foreground": "#9c3e0b"
          },
          {
            "scopes": [
              "variable"
            ],
            "foreground": "#524598"
          },
          {
            "scopes": [
              "constant"
            ],
            "foreground": "#756014"
          }
        ]
      },
      "dark": {
        "rules": [
          {
            "scopes": [
              "keyword"
            ],
            "foreground": "#f1a8cd"
          },
          {
            "scopes": [
              "string"
            ],
            "foreground": "#83d9dd"
          },
          {
            "scopes": [
              "comment"
            ],
            "foreground": "#b9b4ad"
          },
          {
            "scopes": [
              "entity.name.function"
            ],
            "foreground": "#ffac75"
          },
          {
            "scopes": [
              "variable"
            ],
            "foreground": "#c6b2f3"
          },
          {
            "scopes": [
              "constant"
            ],
            "foreground": "#e5cf8a"
          }
        ]
      }
    },
    "frame": "editor",
    "marks": {
      "marked": "#bf771d",
      "inserted": "#25834b",
      "deleted": "#c44848"
    },
    "copy": "standard",
    "tabs": "deferred"
  },
  "fonts": [],
  "catalog": {
    "hero": {
      "routes": [
        {
          "route": "/overview",
          "layout": "banner",
          "title": "A clear view of the work",
          "subtitle": "Terminal Nova / Forge Console",
          "summary": "Readable documentation, explicit design decisions and original technical graphics.",
          "announcement": "Forge Console 0.2.0",
          "actions": [
            {
              "label": "Explore the workflow",
              "href": "/docs/workflow/"
            }
          ]
        }
      ]
    },
    "pageTitle": {
