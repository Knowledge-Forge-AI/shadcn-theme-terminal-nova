{
  "schemaVersion": "tf-paired-profile-v2",
  "name": "anime",
  "version": "0.1.0",
  "description": "Expressive lavender and rose pair with generic serif headings, opaque readable fallbacks, and artwork kept outside the profile",
  "color": {
    "light": {
      "canvas": "#e8d2e2",
      "canvasText": "#2b2031",
      "surface": "#f0deea",
      "surfaceText": "#2b2031",
